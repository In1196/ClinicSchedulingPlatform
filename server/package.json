{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "db:generate": "node --env-file=../.env node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "db:migrate": "node --env-file=../.env node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "db:studio": "node --env-file=../.env node_modules/prisma/build/index.js studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prisma": "6.12.0"
  }
}
